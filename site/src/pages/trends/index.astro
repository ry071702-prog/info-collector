---
import ZineLayout from "../../layouts/ZineLayout.astro";
import ZineStats from "../../components/ZineStats.astro";
import { loadSiteData } from "../../lib/articles";
import { buildSiteStats } from "../../lib/stats";

const siteData = loadSiteData();
const stats = buildSiteStats(siteData.articles, siteData.generated_at, { dailyDays: 30, tagLimit: 10, sourceLimit: 10 });
---

<ZineLayout title="トレンド" description="直近30日の記事数、ジャンル比率、source別配信数を可視化します。" active="feed">
  <section class="hero cat">
    <div class="wrap">
      <div class="dateline"><span class="stamp">トレンド</span><span class="mono">直近30日 · 集計</span></div>
      <h1>トレンド<em>分析</em></h1>
      <p class="lead">直近30日の収集データを、件数推移・ジャンル構成・重要度・source別で俯瞰します</p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:20px">
    <ZineStats stats={stats} rangeLabel="直近30日" />
  </section>
</ZineLayout>
