---
import ZineLayout from "../../layouts/ZineLayout.astro";
import ZineStats from "../../components/ZineStats.astro";
import { loadSiteData } from "../../lib/articles";
import { buildSiteStats } from "../../lib/stats";

const siteData = loadSiteData();
const stats = buildSiteStats(siteData.articles, siteData.generated_at, { dailyDays: 14, tagLimit: 10, sourceLimit: 10 });
---

<ZineLayout title="ダッシュボード" description="記事数、ジャンル、重要度、人気タグ、source別件数を集計したダッシュボード。" active="feed">
  <section class="hero cat">
    <div class="wrap">
      <div class="dateline"><span class="stamp">ダッシュボード</span><span class="mono">直近14日 · 集計</span></div>
      <h1>収集<em>ダッシュボード</em></h1>
      <p class="lead">記事数・ジャンル・重要度・人気タグ・source別の件数をまとめて確認できます</p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:20px">
    <ZineStats stats={stats} rangeLabel="直近14日" />
  </section>
</ZineLayout>
