---
import ZineLayout from "../../layouts/ZineLayout.astro";
import { allArticles, genreLabels, type Article, type Genre } from "../../lib/articles";
import { formatJapaneseDate } from "../../lib/japaneseDate";
import { headline as headlineOf } from "../../lib/zine";
import { existsSync } from "node:fs";
import { join } from "node:path";

export async function getStaticPaths() {
  const articles = allArticles();
  const dates = new Set<string>();
  for (const a of articles) {
    const d = a.timestamp.slice(0, 10);
    if (d) dates.add(d);
  }
  const sorted = [...dates].sort().reverse().slice(0, 30);
  return sorted.map((date) => ({ params: { date } }));
}

const { date } = Astro.params as { date: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = (import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`);

const aiImage = (() => {
  for (const ext of ["jpg", "png"]) {
    if (existsSync(join(process.cwd(), "public", "newspaper-img", `${date}.${ext}`))) {
      return `${base}/newspaper-img/${date}.${ext}`;
    }
  }
  return null;
})();

function imgSrc(a: Article | undefined): string | null {
  if (!a?.image_url) return null;
  return a.image_url.startsWith("http") ? a.image_url : `${base}${a.image_url}`;
}
function isOnDate(article: Article, targetDate: string): boolean {
  return article.timestamp.slice(0, 10) === targetDate;
}

const articlesAll = allArticles().filter((a) => isOnDate(a, date));
const priorityRank: Record<string, number> = { S: 0, A: 1, B: 2, C: 3 };
const sorted = [...articlesAll].sort((a, b) => {
  const p = (priorityRank[a.final_priority] ?? 9) - (priorityRank[b.final_priority] ?? 9);
  if (p !== 0) return p;
  return new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime();
});

const topArticle = sorted[0];
const heroImage = imgSrc(topArticle) ?? imgSrc(sorted.find((a) => imgSrc(a)));
const leads = sorted.slice(1, 4);

const byGenre = (g: Genre): Article[] => {
  const used = new Set([topArticle?.url, ...leads.map((a) => a.url)]);
  return sorted.filter((a) => a.genre === g && !used.has(a.url)).slice(0, 5);
};
const pages = [
  { label: "ゲーム面", items: byGenre("games") },
  { label: "アニメ面", items: byGenre("anime") },
  { label: "Disney 面", items: byGenre("disney") },
];

const formattedDate = formatJapaneseDate(`${date}T12:00:00+09:00`);

const allDates = (() => {
  const set = new Set<string>();
  for (const a of allArticles()) {
    const d = a.timestamp.slice(0, 10);
    if (d) set.add(d);
  }
  return [...set].sort();
})();
const idx = allDates.indexOf(date);
const prevDate = idx > 0 ? allDates[idx - 1] : null;
const nextDate = idx >= 0 && idx < allDates.length - 1 ? allDates[idx + 1] : null;
const issueNo = idx >= 0 ? idx + 1 : allDates.length;

const summaryOf = (a: Article): string => a.summary || a.category_name || "";
const authorOf = (a: Article): string => a.author || a.domain || "unknown";
---

<ZineLayout title={`週刊 情報収集 第${issueNo}号 (${date})`} active="home">
  <section class="wrap" style="padding-top:22px">
    <div class="npz serif">
      {aiImage && (
        <figure class="aiviz">
          <img src={aiImage} alt={`${date} の AI 生成新聞ビジュアル`} loading="eager" />
          <figcaption>AI 生成の新聞ビジュアル(ベータ) · 下は HTML 版</figcaption>
        </figure>
      )}

      <div class="nameplate">
        <span class="ttl">週刊 情報収集</span>
        <span class="meta">第{issueNo}号<br />{formattedDate}</span>
      </div>
      <div class="metline"><span>情報収集 編集部 AI 編</span><span>ソース: X / YouTube / Twitch / RSS</span></div>

      {articlesAll.length === 0 ? (
        <p class="lead" style="display:block;padding:40px 0;text-align:center">この日のデータはまだありません</p>
      ) : (
        <>
          {topArticle && (
            <a class="banner" href={topArticle.url} target="_blank" rel="noreferrer">{headlineOf(topArticle)}</a>
          )}

          <section class="lead">
            {heroImage ? (
              <figure class="hero"><img src={heroImage} alt={topArticle?.category_name ?? ""} loading="eager" /></figure>
            ) : (
              <div></div>
            )}
            <div>
              {topArticle && (
                <p class="lbl">〜 {genreLabels[topArticle.genre]}面 トップ・重要度 {topArticle.final_priority} 〜</p>
              )}
              <p class="sum">{summaryOf(topArticle)}</p>
              {topArticle && <p class="by">{authorOf(topArticle)}</p>}

              {leads.length > 0 && <p class="subhead">関連の動き</p>}
              <div class="rel">
                {leads.map((a) => (
                  <article>
                    <p class="rlbl">{genreLabels[a.genre]}</p>
                    <a href={a.url} target="_blank" rel="noreferrer"><h4>{headlineOf(a)}</h4></a>
                    <p>{summaryOf(a)}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <section class="pages">
            {pages.map(({ label, items }) => (
              <div class="pg">
                <h2>{label}</h2>
                {items.length === 0 ? (
                  <p class="s" style="margin-top:10px">この面の記事はありません</p>
                ) : (
                  <ul>
                    {items.map((a) => (
                      <li>
                        <a href={a.url} target="_blank" rel="noreferrer"><h3>{headlineOf(a)}</h3></a>
                        <p class="m">{authorOf(a)} · 重要度 {a.final_priority}</p>
                        <p class="s">{summaryOf(a)}</p>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </section>

          <p class="npfoot">このページは AI が自動生成した日刊紙です · 全 {articlesAll.length} 件収録</p>
        </>
      )}

      <nav class="npnav">
        <div>{prevDate && <a href={`${home}newspaper/${prevDate}/`}>← 前号 {prevDate}</a>}</div>
        <div style="display:flex;gap:14px;align-items:center">
          <a href={`${home}newspaper/`}>アーカイブ</a>
          <button type="button" class="print" onclick="window.print()">印刷 / PDF</button>
        </div>
        <div>{nextDate && <a href={`${home}newspaper/${nextDate}/`}>次号 {nextDate} →</a>}</div>
      </nav>
    </div>
  </section>
</ZineLayout>
