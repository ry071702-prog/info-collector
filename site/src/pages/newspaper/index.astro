---
import ZineLayout from "../../layouts/ZineLayout.astro";
import { allArticles } from "../../lib/articles";
import { formatJapaneseDate } from "../../lib/japaneseDate";

const home = (import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`);

// 直近30日のうち記事のある日付を新しい順に（[date].astro と同じ UTC 日付規則で集計）
const articles = allArticles();
const dateMap = new Map<string, number>();
for (const a of articles) {
  const d = a.timestamp.slice(0, 10);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(d)) continue;
  dateMap.set(d, (dateMap.get(d) ?? 0) + 1);
}
const dates = [...dateMap.entries()].sort((a, b) => b[0].localeCompare(a[0])).slice(0, 30);
---

<ZineLayout title="新聞アーカイブ" active="home">
  <section class="hero cat">
    <div class="wrap">
      <div class="dateline"><span class="stamp">新聞アーカイブ</span><span class="mono">{dates.length}号 · 直近30日</span></div>
      <h1>その日の<em>紙面</em></h1>
      <p class="lead">毎日その日のニュースを1ページの新聞風レイアウトでまとめます　見出しから元記事へ遷移できます</p>
    </div>
  </section>

  <section class="wrap">
    {dates.length > 0 ? (
      <div class="gridcards">
        {dates.map(([date, count]) => (
          <a class="gcard" href={`${home}newspaper/${date}/`}>
            <span class="nm">{formatJapaneseDate(`${date}T12:00:00+09:00`)}<small>{count} 件を収録</small></span>
            <span class="cnt">読む →</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="lead" style="padding:30px 0">まだ新聞が発行されていません</p>
    )}
  </section>
</ZineLayout>
