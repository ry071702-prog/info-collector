---
import ZineLayout from "../layouts/ZineLayout.astro";
import { loadSiteData, sortArticles, genreLabels, sourceLabel, type Article } from "../lib/articles";

const data = loadSiteData();
const all = sortArticles(data.articles);
const feature = all[0];
const breaking = all.slice(1, 4);
const feed = all.slice(4, 10);

const home = (import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`);
const todayCount = data.window_12h_count ?? 0;

const genreTabs = [
  { key: "games", label: "ゲーム", href: `${home}games/` },
  { key: "anime", label: "アニメ", href: `${home}anime/` },
  { key: "disney", label: "Disney", href: `${home}disney/` },
] as const;

function ago(ts: string): string {
  const diff = Date.now() - new Date(ts).getTime();
  const min = Math.max(1, Math.round(diff / 60000));
  if (min < 60) return `${min}分前`;
  const hours = Math.round(min / 60);
  if (hours < 24) return `${hours}時間前`;
  return `${Math.round(hours / 24)}日前`;
}
const dateFmt = new Intl.DateTimeFormat("ja-JP", {
  timeZone: "Asia/Tokyo", year: "numeric", month: "2-digit", day: "2-digit", weekday: "short",
}).format(new Date()).replaceAll("/", ".");

function firstSentence(s: string): string {
  const t = (s || "").trim();
  const m = t.match(/^[\s\S]{8,58}?。/);
  return (m ? m[0] : t.slice(0, 52)).replace(/。$/, "");
}
// category_name は分類ラベルで重複しがちなので、要約の第1文をヘッドラインにする
function headline(a: Article): string {
  const s = (a.summary || "").trim();
  if (s.length > 8) return firstSentence(s);
  return a.category_name && a.category_name !== "ニュース" ? a.category_name : (a.title_tags[0] || "最新トピック");
}
function detail(a: Article): string {
  const s = (a.summary || "").trim();
  const head = firstSentence(s);
  return s.slice(head.length).replace(/^。/, "").trim();
}
function kicker(a: Article): string {
  return a.category_name && a.category_name !== "ニュース" ? a.category_name : "";
}
---

<ZineLayout title="ホーム" active="home">
  <!-- ===== 今日の一面 ===== -->
  <section class="hero">
    <div class="wrap">
      <div class="dateline">
        <span class="stamp">あなたの号</span>
        <span class="mono">{dateFmt} · 直近12hで {todayCount} 件</span>
      </div>
      <h1>追わなくても<br /><em>ぜんぶ</em>集まる</h1>
      <p class="lead">好きなジャンルを選ぶだけ　AI が24時間集めて要約し、重要なものだけ毎朝あなたの紙面に並べます</p>

      <div class="tabs">
        <span class="chip on">ぜんぶ</span>
        {genreTabs.map((t) => (
          <a class="chip" href={t.href}><span class={`g ${t.key}`} style="width:9px;height:9px;padding:0"></span>{t.label}</a>
        ))}
        <a class="chip" href={`${home}join/`}>＋</a>
      </div>

      {feature && (
        <div class="toprow">
          <a class="feature" href={feature.url} target="_blank" rel="noopener noreferrer">
            <div class={`cover ${feature.image_url ? "has-img" : ""}`} style={feature.image_url ? `background-image:url(${feature.image_url})` : ""}>
              <span class="imgtag">本日の一面</span>
              <span class="big-s">{feature.final_priority}</span>
            </div>
            <div class="body">
              <div class="frow">
                <span class={`g ${feature.genre}`}>{genreLabels[feature.genre]}</span>
                {kicker(feature) && <span class="mono" style="font-size:11px;font-weight:800;color:var(--ink3)">{kicker(feature)}</span>}
                <span class={`s ${feature.final_priority}`}>{feature.final_priority}</span>
              </div>
              <h2>{headline(feature)}</h2>
              {detail(feature) && <p>{detail(feature)}</p>}
              <div class="src">{sourceLabel(feature)} ・ {ago(feature.timestamp)}</div>
            </div>
          </a>

          <aside class="breaking">
            <div class="bh"><span class="dotlive"></span>速報スタック<span class="mono">LIVE</span></div>
            {breaking.map((a) => (
              <a class="brk" href={a.url} target="_blank" rel="noopener noreferrer">
                <div class="frow"><span class={`g ${a.genre}`}>{genreLabels[a.genre]}</span><span class={`s ${a.final_priority}`}>{a.final_priority}</span></div>
                <h3>{headline(a)}</h3>
                <time>{ago(a.timestamp)}</time>
              </a>
            ))}
          </aside>
        </div>
      )}
    </div>
  </section>

  <!-- ===== あなたのフィード ===== -->
  <section class="wrap">
    <div class="sec-h">
      <h2>あなたのフィード</h2>
      <span class="mono">重要度順 · {genreTabs.length}ジャンル</span>
    </div>
    <div class="feed">
      {feed.slice(0, 2).map((a) => (
        <a class="card" href={a.url} target="_blank" rel="noopener noreferrer">
          <div class="frow"><span class={`g ${a.genre}`}>{genreLabels[a.genre]}</span>{kicker(a) && <span class="kick">{kicker(a)}</span>}<span class={`s ${a.final_priority}`}>{a.final_priority}</span></div>
          <h3>{headline(a)}</h3>
          {detail(a) && <p>{detail(a)}</p>}
          <div class="src"><span>{sourceLabel(a)}</span><span>{ago(a.timestamp)}</span></div>
        </a>
      ))}

      <a class="card promo" href={`${home}newspaper/`}>
        <span class="k">1日1枚 · 自動生成</span>
        <h3>今日の「新聞風まとめ」</h3>
        <p>重要ニュースを1枚の紙面に　朝の3分で全体像</p>
        <span class="mini">紙面を開く →</span>
      </a>

      {feed.slice(2).map((a) => (
        <a class="card" href={a.url} target="_blank" rel="noopener noreferrer">
          <div class="frow"><span class={`g ${a.genre}`}>{genreLabels[a.genre]}</span>{kicker(a) && <span class="kick">{kicker(a)}</span>}<span class={`s ${a.final_priority}`}>{a.final_priority}</span></div>
          <h3>{headline(a)}</h3>
          {detail(a) && <p>{detail(a)}</p>}
          <div class="src"><span>{sourceLabel(a)}</span><span>{ago(a.timestamp)}</span></div>
        </a>
      ))}
    </div>
  </section>
</ZineLayout>
