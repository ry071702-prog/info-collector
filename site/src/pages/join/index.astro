---
import ZineLayout from "../../layouts/ZineLayout.astro";
import catalog from "../../data/genre-catalog.json";

const totalGenres = catalog.categories.reduce((n, c) => n + c.genres.length, 0);

// カテゴリ見出しの色（白文字で読める強色に固定）
const catColor: Record<string, string> = {
  games: "#2b56ff", anime: "#7b3ff2", movie: "#f5333a", sports: "#0aa564",
  tech: "#141009", music: "#7b3ff2", general: "#57503f",
};
---

<ZineLayout title="はじめる" active="genres" description="興味のあるジャンルを選ぶだけ。AI が集めて要約した最新情報が、毎朝あなたのメールに届きます。">
  <section class="hero cat">
    <div class="wrap">
      <div class="dateline">
        <span class="stamp">はじめる</span>
        <span class="mono">先行登録 · {totalGenres}ジャンル以上</span>
      </div>
      <h1>好きなジャンルを<br /><em>選ぶだけ</em></h1>
      <p class="lead">ゲーム・アニメ・スポーツ・AI など、興味のあるものを選択　AI が集めて要約し、重要なものだけ毎朝あなたのメールに届けます</p>
    </div>
  </section>

  <section class="wrap">
    <form id="join-form" class="onb" novalidate>
      <div class="band"><span class="stamp2">はじめる</span><b>好きなジャンルを選んで、あなたの号を作る</b></div>
      <div class="inner">
        <div class="steprow">
          <span class="step"><b>01</b>　興味のあるジャンルを選ぶ（あとで変えられます）</span>
          <span class="selcount" id="selected-count">0 件選択中</span>
        </div>

        {catalog.categories.map((cat) => (
          <div class="grp">
            <span class="gt" style={`background:${catColor[cat.id] ?? "var(--ink)"}`}>{cat.label}</span>
            <div class="prow">
              {cat.genres.map((g) => (
                <button type="button" class="genre-chip" data-genre={g.slug} aria-pressed="false">{g.name}</button>
              ))}
            </div>
          </div>
        ))}

        <div class="signup">
          <input id="join-email" type="email" inputmode="email" autocomplete="email" required placeholder="you@example.com" aria-label="メールアドレス" />
          <button type="submit" id="join-submit">先行登録する</button>
        </div>
        <p id="join-error" class="err hidden" role="alert"></p>
        <p class="fine">登録は無料　配信はいつでも停止できます　現在準備中のため、配信の開始準備が整いましたら、ご登録のアドレスにご連絡します</p>
      </div>
    </form>

    <div id="join-success" class="onb-success hidden">
      <div class="chk">✓</div>
      <h2>先行登録が完了しました</h2>
      <p>選んだジャンルの最新情報を、準備が整いしだいお届けします　ご登録ありがとうございます</p>
    </div>

    <p id="join-proof" class="proof" hidden></p>
  </section>

  <script>
    const form = document.getElementById("join-form") as HTMLFormElement | null;
    const emailInput = document.getElementById("join-email") as HTMLInputElement | null;
    const submitBtn = document.getElementById("join-submit") as HTMLButtonElement | null;
    const errorEl = document.getElementById("join-error");
    const countEl = document.getElementById("selected-count");
    const successEl = document.getElementById("join-success");
    const proofEl = document.getElementById("join-proof");
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".genre-chip"));
    const selected = new Set<string>();

    const updateCount = () => {
      if (countEl) countEl.textContent = `${selected.size} 件選択中`;
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const slug = chip.dataset.genre;
        if (!slug) return;
        const pressed = chip.getAttribute("aria-pressed") === "true";
        chip.setAttribute("aria-pressed", String(!pressed));
        if (pressed) selected.delete(slug);
        else selected.add(slug);
        updateCount();
      });
    });

    const showError = (msg: string) => {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.classList.remove("hidden");
    };
    const clearError = () => errorEl?.classList.add("hidden");

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearError();
      const email = emailInput?.value.trim().toLowerCase() ?? "";
      if (selected.size === 0) {
        showError("興味のあるジャンルを1つ以上選んでください");
        return;
      }
      if (!EMAIL_RE.test(email)) {
        showError("メールアドレスの形式が正しくありません");
        emailInput?.focus();
        return;
      }
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "登録中…";
      }
      try {
        const res = await fetch("/api/signup", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, genres: [...selected], referrer: document.referrer || null }),
        });
        if (!res.ok) {
          const data = (await res.json().catch(() => ({}))) as { error?: string };
          throw new Error(data.error || "登録に失敗しました　時間をおいて再度お試しください");
        }
        form.classList.add("hidden");
        successEl?.classList.remove("hidden");
        successEl?.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch (err) {
        showError(err instanceof Error ? err.message : "登録に失敗しました");
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "先行登録する";
        }
      }
    });

    fetch("/api/signup")
      .then((r) => (r.ok ? r.json() : null))
      .then((data: { count?: number } | null) => {
        if (data && typeof data.count === "number" && data.count > 0 && proofEl) {
          proofEl.textContent = `これまでに ${data.count} 人が先行登録しています`;
          proofEl.hidden = false;
        }
      })
      .catch(() => {});
  </script>
</ZineLayout>
