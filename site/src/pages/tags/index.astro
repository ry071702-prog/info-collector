---
import ZineLayout from "../../layouts/ZineLayout.astro";
import { loadSiteData } from "../../lib/articles";
import { MIN_TAG_PAGE_COUNT, allTagEntries, tagPageEntries, tagPathSegment } from "../../lib/stats";

const siteData = loadSiteData();
const allTags = allTagEntries(siteData.articles);
const tags = tagPageEntries(siteData.articles);
const omittedTagCount = allTags.length - tags.length;
const home = (import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`);
---

<ZineLayout title="タグ一覧" description="記事に自動付与されたタグを件数順に一覧します。">
  <section class="hero cat">
    <div class="wrap">
      <div class="dateline"><span class="stamp">タグ</span><span class="mono">{tags.length}タグ · {MIN_TAG_PAGE_COUNT}件以上を掲載</span></div>
      <h1>タグ<em>一覧</em></h1>
      <p class="lead">記事に自動付与されたタグを人気順に　タグを選ぶと、その話題を含む記事だけを読めます</p>
    </div>
  </section>

  <section class="wrap">
    {tags.length > 0 ? (
      <div class="gridcards">
        {tags.map((tag) => (
          <a class="gcard" href={`${home}tags/${tag.slug || tagPathSegment(tag.tag)}/`}>
            <span class="nm">#{tag.tag}</span>
            <span class="cnt">{tag.count}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="lead" style="padding:30px 0">集計できるタグはまだありません</p>
    )}
    {omittedTagCount > 0 && (
      <p class="note-line">その他 {omittedTagCount} 個の少数タグはページ化していません</p>
    )}
  </section>
</ZineLayout>
