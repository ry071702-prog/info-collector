---
import ZineLayout from "../../layouts/ZineLayout.astro";
import ZineCard from "../../components/ZineCard.astro";
import { loadSiteData, sortArticles } from "../../lib/articles";
import { articlesForTag, tagPageEntries, tagPathSegment } from "../../lib/stats";

export function getStaticPaths() {
  const siteData = loadSiteData();
  return tagPageEntries(siteData.articles).map((tag) => ({
    params: { tag: tagPathSegment(tag.tag) },
    props: { tag: tag.tag, count: tag.count },
  }));
}

interface Props { tag: string; count: number; }
const { tag, count } = Astro.props;
const siteData = loadSiteData();
const articles = sortArticles(articlesForTag(siteData.articles, tag));
const shown = articles.slice(0, 48);
const home = (import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`);
---

<ZineLayout title={`#${tag}`} description={`#${tag} を含む記事一覧。`} active="feed">
  <section class="hero cat">
    <div class="wrap">
      <div class="dateline">
        <span class="stamp">タグ</span>
        <span class="mono">{count}件 · 新着順</span>
      </div>
      <h1>#<em>{tag}</em></h1>
      <div class="tabs" style="margin-top:16px">
        <a class="chip" href={`${home}tags/`}>← タグ一覧</a>
        <a class="chip" href={home}>ホーム</a>
      </div>
    </div>
  </section>

  <section class="wrap">
    {shown.length > 0 ? (
      <div class="feed" style="margin-top:22px">
        {shown.map((a) => <ZineCard article={a} />)}
      </div>
    ) : (
      <p class="lead" style="padding:30px 0">このタグの記事はまだありません</p>
    )}
  </section>
</ZineLayout>
