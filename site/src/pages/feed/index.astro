---
import ZineLayout from "../../layouts/ZineLayout.astro";
import ZineCard from "../../components/ZineCard.astro";
import { allArticles, sortArticles, genres, genreLabels, latestByGenre, loadDigests } from "../../lib/articles";

const home = (import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`);
const overall = sortArticles(allArticles());
const overallShown = overall.slice(0, 24);
const digests = loadDigests().slice(0, 12);

const tabs = [
  { key: "games", label: "ゲーム" },
  { key: "anime", label: "アニメ" },
  { key: "disney", label: "Disney" },
] as const;
---

<ZineLayout title="フィード" active="feed">
  <section class="hero cat">
    <div class="wrap">
      <div class="dateline">
        <span class="stamp">フィード</span>
        <span class="mono">{overall.length}件 · 直近30日 · 重要度と新しさで整理</span>
      </div>
      <h1>統合<em>ニュース</em></h1>
      <div class="tabs">
        <span class="chip on">ぜんぶ</span>
        {tabs.map((t) => (
          <a class="chip" href={`${home}${t.key}/`}><span class={`g ${t.key}`} style="width:9px;height:9px;padding:0"></span>{t.label}</a>
        ))}
        <a class="chip" href={`${home}join/`}>＋</a>
      </div>
    </div>
  </section>

  {tabs.map((t) => {
    const items = latestByGenre(t.key, 6);
    if (items.length === 0) return null;
    return (
      <section class="wrap">
        <div class="sec-h">
          <h2>{t.label}</h2>
          <a class="more" href={`${home}${t.key}/`}>すべて見る →</a>
        </div>
        <div class="feed" style="margin-top:20px">
          {items.map((a) => <ZineCard article={a} />)}
        </div>
      </section>
    );
  })}

  <section class="wrap">
    <div class="sec-h"><h2>全体の新着</h2><span class="mono">最新24件</span></div>
    <div class="feed" style="margin-top:20px">
      {overallShown.map((a) => <ZineCard article={a} />)}
    </div>
  </section>

  {digests.length > 0 && (
    <section class="wrap">
      <div class="sec-h"><h2>デイリーまとめ</h2><span class="mono">過去の紙面</span></div>
      <div class="digest-strip">
        {digests.map((d) => (
          <a href={`${home}digest/${d.slug}/`}><span class="dd mono">{d.date}</span>{d.label}</a>
        ))}
      </div>
    </section>
  )}
</ZineLayout>
