---
import ZineLayout from "../../layouts/ZineLayout.astro";

const home = (import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`);
---

<ZineLayout title="保存コレクション" description="自分で保存したURLやメモをAI要約つきで保管する個人用コレクション。" active="saved">
  <section class="hero cat">
    <div class="wrap">
      <div class="dateline"><span class="stamp">コレクション</span><span class="mono">保存＋AI要約 · 個人用</span></div>
      <h1>保存<em>コレクション</em></h1>
      <p class="lead">気になったURLやメモを保存し、AI要約・タグ・重要度つきでひとつにまとめます　保存はパスコードが必要です</p>
    </div>
  </section>

  <section class="wrap">
    <div class="panel" aria-labelledby="collection-save-title">
      <h2 id="collection-save-title">保存する</h2>
      <p class="ph">URL、またはメモだけでも保存できます　要約に失敗した場合も保存は継続します</p>
      <form class="cform" data-collection-form>
        <div>
          <label class="clabel" for="collection-url">URL</label>
          <input id="collection-url" name="url" type="url" inputmode="url" placeholder="https://example.com/article" class="cfield" data-collection-url />
        </div>
        <div>
          <label class="clabel" for="collection-note">メモ</label>
          <textarea id="collection-note" name="note" rows="4" placeholder="保存理由や補足メモ" class="cfield" style="resize:vertical" data-collection-note></textarea>
        </div>
        <div class="crow">
          <div class="grow">
            <label class="clabel" for="collection-passcode">保存パスコード</label>
            <input id="collection-passcode" name="passcode" type="password" autocomplete="current-password" class="cfield" data-collection-passcode required />
          </div>
          <button type="submit" class="cbtn" data-collection-submit>保存</button>
        </div>
        <label class="ccheck"><input type="checkbox" data-collection-remember checked /> この端末にパスコードを保存</label>
        <p class="cstatus" role="status" aria-live="polite" data-collection-status></p>
      </form>
    </div>

    <div class="sec-h" style="margin-top:48px">
      <h2>保存済み</h2>
      <button type="button" class="chip" data-collection-refresh>再読み込み</button>
    </div>
    <p class="note-line" data-collection-loading>読み込み中...</p>
    <p class="note-line hidden" data-collection-empty>まだ保存はありません</p>
    <div class="feed" style="margin-top:20px" data-collection-list></div>
  </section>

  <script is:inline>
    (() => {
      const STORAGE_KEY = "info-collector-save-passcode";
      const form = document.querySelector("[data-collection-form]");
      const urlInput = document.querySelector("[data-collection-url]");
      const noteInput = document.querySelector("[data-collection-note]");
      const passcodeInput = document.querySelector("[data-collection-passcode]");
      const rememberInput = document.querySelector("[data-collection-remember]");
      const submitButton = document.querySelector("[data-collection-submit]");
      const status = document.querySelector("[data-collection-status]");
      const loading = document.querySelector("[data-collection-loading]");
      const empty = document.querySelector("[data-collection-empty]");
      const list = document.querySelector("[data-collection-list]");
      const refreshButton = document.querySelector("[data-collection-refresh]");

      const setStatus = (message, tone) => {
        if (!(status instanceof HTMLElement)) return;
        status.textContent = message;
        status.classList.toggle("err", tone === "error");
        status.classList.toggle("ok", tone === "success");
      };
      const escapeHtml = (value) =>
        String(value ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;");
      const formatDate = (value) => {
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return "";
        return new Intl.DateTimeFormat("ja-JP", { timeZone: "Asia/Tokyo", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hour12: false }).format(date).replaceAll("/", "-");
      };

      const renderItem = (item) => {
        const tags = Array.isArray(item.tags) ? item.tags : [];
        const title = item.title || item.url || "無題";
        const href = item.url ? escapeHtml(item.url) : "";
        const imp = escapeHtml(item.importance || "C");
        const titleNode = href
          ? `<a href="${href}" target="_blank" rel="noreferrer"><h3>${escapeHtml(title)}</h3></a>`
          : `<h3>${escapeHtml(title)}</h3>`;
        return `
          <article class="card" data-collection-card data-id="${escapeHtml(item.id)}">
            <div class="frow"><span class="s ${imp}">${imp}</span><span class="kick">${escapeHtml(item.category || "other")}</span></div>
            ${titleNode}
            <p>${escapeHtml(item.summary || "要約はまだありません")}</p>
            ${item.note ? `<div class="cnote">${escapeHtml(item.note)}</div>` : ""}
            ${tags.length ? `<div class="ctags">${tags.map((t) => `<span class="ctag">#${escapeHtml(t)}</span>`).join("")}</div>` : ""}
            <div class="src"><span>${escapeHtml(item.domain || "manual")}</span><time>${escapeHtml(formatDate(item.created_at))}</time></div>
            <button type="button" class="cdel" data-collection-delete="${escapeHtml(item.id)}">削除</button>
          </article>`;
      };
      const renderItems = (items) => {
        if (!(list instanceof HTMLElement) || !(empty instanceof HTMLElement)) return;
        list.innerHTML = items.map(renderItem).join("");
        empty.classList.toggle("hidden", items.length > 0);
      };
      const loadItems = async () => {
        if (loading instanceof HTMLElement) loading.hidden = false;
        try {
          const response = await fetch("/api/collection", { headers: { Accept: "application/json" } });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || "読み込みに失敗しました");
          renderItems(Array.isArray(data.items) ? data.items : []);
          setStatus("");
        } catch (error) {
          setStatus(error instanceof Error ? error.message : "読み込みに失敗しました", "error");
        } finally {
          if (loading instanceof HTMLElement) loading.hidden = true;
        }
      };
      const passcodeValue = () => (passcodeInput instanceof HTMLInputElement ? passcodeInput.value : "");
      const rememberPasscode = () => {
        if (!(rememberInput instanceof HTMLInputElement)) return;
        if (rememberInput.checked) localStorage.setItem(STORAGE_KEY, passcodeValue());
        else localStorage.removeItem(STORAGE_KEY);
      };
      const savedPasscode = localStorage.getItem(STORAGE_KEY);
      if (savedPasscode && passcodeInput instanceof HTMLInputElement) passcodeInput.value = savedPasscode;

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!(urlInput instanceof HTMLInputElement) || !(noteInput instanceof HTMLTextAreaElement)) return;
        const payload = { url: urlInput.value.trim(), note: noteInput.value.trim(), passcode: passcodeValue() };
        if (!payload.url && !payload.note) { setStatus("URLかメモを入力してください", "error"); return; }
        rememberPasscode();
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
        setStatus("保存中です　AI要約に少し時間がかかる場合があります");
        try {
          const response = await fetch("/api/save", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(payload) });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || "保存に失敗しました");
          urlInput.value = ""; noteInput.value = "";
          setStatus("保存しました", "success");
          await loadItems();
        } catch (error) {
          setStatus(error instanceof Error ? error.message : "保存に失敗しました", "error");
        } finally {
          if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        }
      });
      list?.addEventListener("click", async (event) => {
        const target = event.target instanceof Element ? event.target.closest("[data-collection-delete]") : null;
        if (!(target instanceof HTMLButtonElement)) return;
        const id = target.dataset.collectionDelete;
        if (!id) return;
        if (!passcodeValue()) { setStatus("削除にはパスコードが必要です", "error"); passcodeInput?.focus?.(); return; }
        if (!window.confirm("この保存を削除しますか?")) return;
        rememberPasscode();
        target.disabled = true;
        try {
          const response = await fetch(`/api/item/${encodeURIComponent(id)}`, { method: "DELETE", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({ passcode: passcodeValue() }) });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || "削除に失敗しました");
          target.closest("[data-collection-card]")?.remove();
          if (list instanceof HTMLElement && list.children.length === 0 && empty instanceof HTMLElement) empty.classList.remove("hidden");
          setStatus("削除しました", "success");
        } catch (error) {
          target.disabled = false;
          setStatus(error instanceof Error ? error.message : "削除に失敗しました", "error");
        }
      });
      refreshButton?.addEventListener("click", loadItems);
      loadItems();
    })();
  </script>
</ZineLayout>
