---
import "../styles/zine.css";

interface Props {
  title: string;
  description?: string;
  active?: "home" | "feed" | "genres" | "saved";
}

const {
  title,
  description = "好きなジャンルを選ぶだけ。AI が最新情報を集めて要約し、重要なものだけ毎朝あなたの紙面に届けるニュースリーダー。",
  active = "home",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;
const pageTitle = `${title} | 情報収集`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4efe0" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="manifest" href={`${home}manifest.json`} />
    <link rel="icon" href={`${home}icon-192.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${home}icon-192.svg`} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only">本文へスキップ</a>
    <header class="mast">
      <div class="mast-in">
        <a class="brand" href={home} aria-label="情報収集 ホーム">情報<b>収集</b></a>
        <nav class="top" aria-label="メイン">
          <a href={home} class={active === "home" ? "on" : ""}>ホーム</a>
          <a href={`${home}feed/`} class={active === "feed" ? "on" : ""}>フィード</a>
          <a href={`${home}join/`} class={active === "genres" ? "on" : ""}>ジャンル</a>
          <a href={`${home}collection/`} class={active === "saved" ? "on" : ""}>保存</a>
        </nav>
        <button type="button" class="mast-toggle" data-theme-toggle aria-label="テーマを切り替え">◐</button>
        <a class="mast-cta" href={`${home}join/`}>＋ ジャンルを追加</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="zfoot">
      <div class="wrap foot-in">
        <a class="brand" href={home}>情報<b>収集</b></a>
        <nav class="foot-nav" aria-label="フッター">
          <a href={`${home}join/`}>ジャンル</a>
          <a href={`${home}collection/`}>保存した記事</a>
          <a href={`${home}privacy/`}>プライバシー</a>
          <a href={`${home}terms/`}>利用規約</a>
        </nav>
        <span class="copy">© 2026 情報収集 · 個人運用</span>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const btn = document.querySelector("[data-theme-toggle]");
        btn?.addEventListener("click", () => {
          const cur = document.documentElement.dataset.theme;
          const isDark = cur ? cur === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          const next = isDark ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          localStorage.setItem("theme", next);
        });
      })();
    </script>
  </body>
</html>
